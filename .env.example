# Copy this file to .env and fill in YOUR OWN values. Never commit .env.

# --- Required ---
GOOGLE_API_KEY=
VIDEOSDK_TOKEN=
# From your VideoSDK dashboard: a routing rule bound to agent_id "my_telephony_agent"
VIDEOSDK_ROUTING_RULE_ID=
# The caller number on that routing rule, in international format
VIDEOSDK_CALLER_ID=+91XXXXXXXXXX

# --- Optional ---
# Default number used by `python dial.py` when no argument is given
PODHUB_DEFAULT_TARGET=

# Real (billable) phone calls. 0 = refuse to dial, 1 = allowed.
# start.bat (Windows) forces this to 1; with start.sh (Mac) set it here.
PODHUB_ALLOW_REAL_DIAL=0
